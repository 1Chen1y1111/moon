{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@moon/core": ["../core/src"],
      "@moon/core/*": ["../core/src/*"],
      "@moon/shared": ["../shared/src"],
      "@moon/shared/*": ["../shared/src/*"],
      "@moon/server-core": ["src"],
      "@moon/server-core/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
