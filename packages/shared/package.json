{
  "name": "@moon/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent/index.ts",
    "./agent/backend": "./src/agent/backend/index.ts",
    "./agent/backend/*": "./src/agent/backend/*.ts",
    "./agent/*": "./src/agent/*.ts",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*.ts",
    "./domain/*": "./src/domain/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.123",
    "@mariozechner/pi-ai": "0.73.1",
    "@moon/core": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
