{
  "name": "@moon/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap/*": "./src/bootstrap/*.ts",
    "./db/*": "./src/db/*.ts",
    "./repositories/*": "./src/repositories/*.ts",
    "./services/*": "./src/services/*.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@moon/server-core": "workspace:*",
    "@moon/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
