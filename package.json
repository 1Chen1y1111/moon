{
  "name": "moon-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Moon monorepo workspace",
  "author": "example.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "update-shadcn": "pnpm --filter @moon/desktop update-shadcn",
    "reset:data": "pnpm --filter @moon/desktop reset:data",
    "reset:data:all": "pnpm --filter @moon/desktop reset:data:all",
    "typecheck:node": "pnpm --filter @moon/desktop typecheck:node",
    "typecheck:web": "pnpm --filter @moon/desktop typecheck:web",
    "typecheck": "pnpm --filter @moon/shared typecheck && pnpm --filter @moon/ipc typecheck && pnpm --filter @moon/ui typecheck && pnpm --filter @moon/desktop typecheck",
    "start": "pnpm --filter @moon/desktop start",
    "dev": "pnpm --filter @moon/desktop dev",
    "build:icons": "pnpm --filter @moon/desktop build:icons",
    "build": "pnpm --filter @moon/desktop build",
    "build:unpack": "pnpm --filter @moon/desktop build:unpack",
    "build:win": "pnpm --filter @moon/desktop build:win",
    "build:mac": "pnpm --filter @moon/desktop build:mac",
    "build:linux": "pnpm --filter @moon/desktop build:linux"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/better-sqlite3",
        "better-sqlite3"
      ]
    }
  }
}
