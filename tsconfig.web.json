{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer": [
        "src/renderer/src"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared": [
        "src/shared"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@shadcn": [
        "src/shadcn"
      ],
      "@shadcn/ui": [
        "src/shadcn/ui"
      ],
      "@shadcn/lib": [
        "src/shadcn/lib"
      ],
      "@shadcn/lib/utils": [
        "src/shadcn/lib/utils.ts"
      ],
      "@shadcn/*": [
        "src/shadcn/*"
      ]
    }
  }
}
