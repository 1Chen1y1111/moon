{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/ipc/**/*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@ipc": ["src/ipc"],
      "@ipc/*": ["src/ipc/*"],
      "@moon/server-core": ["../../packages/server-core/src"],
      "@moon/server-core/*": ["../../packages/server-core/src/*"],
      "@moon/server": ["../../packages/server/src"],
      "@moon/server/*": ["../../packages/server/src/*"],
      "@moon/shared": ["../../packages/shared/src"],
      "@moon/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
