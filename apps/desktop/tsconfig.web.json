{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "../../packages/ipc/src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/ui/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer": [
        "src/renderer/src"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@moon/ipc": ["../../packages/ipc/src"],
      "@moon/ipc/*": ["../../packages/ipc/src/*"],
      "@moon/shared": ["../../packages/shared/src"],
      "@moon/shared/*": ["../../packages/shared/src/*"],
      "@moon/ui": ["../../packages/ui/src"],
      "@moon/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
