{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "../../packages/ipc/src/**/*",
    "../../packages/shared/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@moon/ipc": ["../../packages/ipc/src"],
      "@moon/ipc/*": ["../../packages/ipc/src/*"],
      "@moon/shared": ["../../packages/shared/src"],
      "@moon/shared/*": ["../../packages/shared/src/*"]
    }
  }
}
