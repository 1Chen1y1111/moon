{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "tests/**/*",
    "src/renderer/src/env.d.ts",
    "src/preload/*.d.ts",
    "src/ipc/**/*",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["node", "electron-vite/node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@ipc": ["src/ipc"],
      "@ipc/*": ["src/ipc/*"],
      "@shared": ["src/shared"],
      "@shared/*": ["src/shared/*"],
      "@main": ["src/main"],
      "@main/*": ["src/main/*"],
      "@preload": ["src/preload"],
      "@preload/*": ["src/preload/*"],
      "@renderer": ["src/renderer/src"],
      "@renderer/*": ["src/renderer/src/*"],
      "@shadcn": ["src/shadcn"],
      "@shadcn/ui": ["src/shadcn/ui"],
      "@shadcn/lib": ["src/shadcn/lib"],
      "@shadcn/lib/utils": ["src/shadcn/lib/utils.ts"],
      "@shadcn/*": ["src/shadcn/*"],
      "@tests": ["tests"],
      "@tests/*": ["tests/*"]
    }
  }
}
