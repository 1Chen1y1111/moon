{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "tests/**/*",
    "apps/desktop/src/renderer/src/env.d.ts",
    "apps/desktop/src/preload/*.d.ts",
    "packages/ipc/src/**/*",
    "packages/shared/src/**/*",
    "packages/ui/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "electron-vite/node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@moon/ipc": ["packages/ipc/src"],
      "@moon/ipc/*": ["packages/ipc/src/*"],
      "@moon/shared": ["packages/shared/src"],
      "@moon/shared/*": ["packages/shared/src/*"],
      "@moon/ui": ["packages/ui/src"],
      "@moon/ui/*": ["packages/ui/src/*"],
      "@main": ["apps/desktop/src/main"],
      "@main/*": ["apps/desktop/src/main/*"],
      "@preload": ["apps/desktop/src/preload"],
      "@preload/*": ["apps/desktop/src/preload/*"],
      "@renderer": ["apps/desktop/src/renderer/src"],
      "@renderer/*": ["apps/desktop/src/renderer/src/*"],
      "@tests": ["tests"],
      "@tests/*": ["tests/*"]
    }
  }
}
